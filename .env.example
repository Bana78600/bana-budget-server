# Copy this file to .env and fill in your values

# Anthropic Claude API key (for AI SMS parsing + chatbot)
# Get it from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Email settings (for bug report notifications to developer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=banabudgetai@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Developer email (receives bug reports)
DEVELOPER_EMAIL=banabudgetai@gmail.com

# Server settings
PORT=8000
ALLOWED_ORIGINS=*
